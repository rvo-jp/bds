# 既存のTLS・他のサイト設定と統合してください。
# この例はDiscord受付専用です。他サイトと共有する場合、以下の
# サーバー全体の期限がそのサイトにも適切か確認して統合してください。
{
	servers {
		timeouts {
			read_header 2s
			read_body 2s
			write 5s
			idle 30s
		}
	}
}
minecraft.example.com {
	request_body {
		max_size 64KB
	}
	handle /interactions {
		reverse_proxy 127.0.0.1:8765 {
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
				read_timeout 5s
				write_timeout 5s
			}
		}
	}
	handle {
		respond "Not found" 404
	}
}
