[Unit]
Description=Orderly VPS reboot requested through Discord
After=network-online.target

[Service]
Type=oneshot
User=root
Environment=BDS_CONFIG=/opt/bds/bds.conf
RuntimeDirectory=bds-control-reboot
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/python3 /opt/bds/discord-control/result.py reboot running
ExecStart=/opt/bds/bds.sh control-reboot
ExecStopPost=/usr/bin/python3 /opt/bds/discord-control/result.py reboot finished
TimeoutStartSec=20min
TimeoutStopSec=30
KillMode=mixed
SendSIGKILL=no
