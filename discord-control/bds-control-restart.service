[Unit]
Description=Announced Minecraft restart requested through Discord
After=network-online.target

[Service]
Type=oneshot
User=root
Environment=BDS_CONFIG=/opt/bds/bds.conf
RuntimeDirectory=bds-control-restart
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/python3 /opt/bds/discord-control/result.py restart running
ExecStart=/opt/bds/bds.sh control-restart
ExecStopPost=/usr/bin/python3 /opt/bds/discord-control/result.py restart finished
TimeoutStartSec=20min
TimeoutStopSec=30
KillMode=mixed
SendSIGKILL=no
