[Unit]
Description=BDS Discord restart/reboot interaction receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bds-discord-control
Group=bds-discord-control
WorkingDirectory=/opt/bds/discord-control
ExecStart=/usr/bin/python3 /opt/bds/discord-control/server.py
Restart=on-failure
RestartSec=5
StateDirectory=bds-discord-control
StateDirectoryMode=0700
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# sudo is restricted to starting the two fixed root-owned units.
NoNewPrivileges=false
MemoryMax=128M
CPUQuota=20%
TasksMax=32

[Install]
WantedBy=multi-user.target
