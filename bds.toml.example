# 公開可能な設定。Webhook URL・Bot Tokenは書かないでください。
# 既定値はコードで一元管理します。全項目の確認: bdsctl --default-config
# このファイルにはDiscordを有効にするための上書きだけを記載します。
# 保存先や保持数などを変える場合は、--default-config の対応項目を追加してください。

# 以下のIDと公開鍵はダミーです。利用するDiscordアプリ・サーバーの値へ置き換えてください。
[discord]
enabled = true
application_id = "1111111111111111111"
public_key = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
guild_id = "2222222222222222222"
allowed_users = ["3333333333333333333"]
